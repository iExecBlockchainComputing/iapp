{
  "name": "iapp-api",
  "version": "1.0.1",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env ./src/index.js",
    "dev": "tsx --env-file=.env --watch ./src/index.js",
    "dev:pretty": "tsx --env-file=.env --watch ./src/index.js | pino-pretty -tc",
    "check-format": "prettier --check .",
    "check-types": "tsc --project tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint src"
  },
  "dependencies": {
    "cls-hooked": "^4.2.2",
    "express": "^5.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "tsx": "^4.19.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/cls-hooked": "^4.3.9",
    "@types/express": "^5.0.1",
    "eslint": "^9.24.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "globals": "^16.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
